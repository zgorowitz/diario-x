generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Person - Core model for people in the network
model Person {
  id String @id @default(uuid())

  // Basic Identity
  firstName String
  lastName  String?
  email     String?
  phone     String?
  photoUrl  String?

  // Demographics
  age      Int?
  gender   String?
  religion String?

  // Location
  city    String?
  country String?

  // Professional
  occupation String?
  company    String?

  // Additional Info
  notes String? @db.Text

  // Metadata
  addedBy   String
  userId    String? // Clerk user ID if they join
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  connectionsFrom Connection[] @relation("FromPerson")
  connectionsTo   Connection[] @relation("ToPerson")

  @@index([firstName, lastName])
  @@index([email])
  @@index([userId])
  @@index([city])
  @@index([occupation])
}

// Connection - Relationships between people
model Connection {
  id String @id @default(uuid())

  fromPersonId String
  toPersonId   String

  // Relationship info
  relationshipTypes String[] // Multiple types like ["friend", "colleague"]

  // Context
  howMet      String?
  whenMetYear Int?

  // Calculated strength
  strengthScore Float?

  // Metadata
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromPerson Person @relation("FromPerson", fields: [fromPersonId], references: [id], onDelete: Cascade)
  toPerson   Person @relation("ToPerson", fields: [toPersonId], references: [id], onDelete: Cascade)

  @@unique([fromPersonId, toPersonId])
  @@index([fromPersonId])
  @@index([toPersonId])
}

// RelationshipType - Pre-defined relationship types
model RelationshipType {
  id        String   @id @default(uuid())
  name      String   @unique
  category  String? // family, friend, professional, community
  strength  Float    @default(5)
  color     String?
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([category])
}

// Note: Old Amazon seller tables exist in this database but are not managed by this schema
// They are kept separate for another project
